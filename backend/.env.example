PORT=3001
DATABASE_URL=postgresql://user:password@localhost:5432/okta_agents
OKTA_ORG_URL=https://your-org.okta.com
OKTA_M2M_CLIENT_ID=your-api-services-client-id
OKTA_M2M_CLIENT_SECRET=your-api-services-client-secret
FRONTEND_URL=http://localhost:3000

# Exercise feature — this backend's own public base URL, used to build the OAuth redirect_uri
# for the User Access PKCE login test (Okta redirects back to <BACKEND_PUBLIC_URL>/api/exercise/...).
BACKEND_PUBLIC_URL=http://localhost:3001

# Exercise feature — client credentials of an Okta API Services (OAuth Service) app that
# originates the Machine Access chain's step 1 (client_credentials grant).
EXERCISE_SERVICE_CLIENT_ID=
EXERCISE_SERVICE_CLIENT_SECRET=

# Exercise feature — id of a Custom Authorization Server used as the shared Machine Access
# target/audience when streamlining caller setup (ensureMachineAccess).
EXERCISE_SHARED_AUTH_SERVER_ID=
